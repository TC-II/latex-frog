+void editor_live_page(int page, int pages, int width, int height, fz_buffer *png)
+{
+  // Sólo hay mensaje en JSON: el protocolo de s-expresiones no lo conoce.
+  if (protocol != EDITOR_JSON || !png)
+    return;
+  fprintf(stdout, "[\"live-page\", %d, %d, %d, %d, \"", page, pages, width, height);
+  // Base64 a mano sobre stdout: la imagen puede pesar cientos de KB y no hace falta copiarla.
+  static const char tabla[] =
+      "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+  const unsigned char *d = png->data;
+  size_t n = png->len, i = 0;
+  for (; i + 2 < n; i += 3)
+  {
+    unsigned v = (d[i] << 16) | (d[i + 1] << 8) | d[i + 2];
+    putc_unlocked(tabla[(v >> 18) & 63], stdout);
+    putc_unlocked(tabla[(v >> 12) & 63], stdout);
+    putc_unlocked(tabla[(v >> 6) & 63], stdout);
+    putc_unlocked(tabla[v & 63], stdout);
+  }
+  if (n - i == 1)
+  {
+    unsigned v = d[i] << 16;
+    putc_unlocked(tabla[(v >> 18) & 63], stdout);
+    putc_unlocked(tabla[(v >> 12) & 63], stdout);
+    fputs("==", stdout);
+  }
+  else if (n - i == 2)
+  {
+    unsigned v = (d[i] << 16) | (d[i + 1] << 8);
+    putc_unlocked(tabla[(v >> 18) & 63], stdout);
+    putc_unlocked(tabla[(v >> 12) & 63], stdout);
+    putc_unlocked(tabla[(v >> 6) & 63], stdout);
+    putc_unlocked('=', stdout);
+  }
+  fprintf(stdout, "\"]\n");
+  fflush(stdout);
+}
