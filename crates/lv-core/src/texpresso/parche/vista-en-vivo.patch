+/* Parche de Latex Frog: la página que se acaba de dibujar en la ventana, también como imagen PNG por stdout.
+ *
+ * Se vuelve a dibujar la misma lista de dibujo (la que ya armó el motor) a un pixmap del ancho pedido, sin pasar por SDL ni por el
+ * tema de colores de la ventana (fondo blanco, texto negro). Para no mandar lo mismo dos veces (display_page corre en cada
+ * RELOAD_EVENT, haya o no cambiado la página) se compara un hash de los píxeles con el de la última imagen mandada. */
+static uint64_t live_hash_bytes(const unsigned char *p, size_t n)
+{
+  uint64_t h = 1469598103934665603ULL; // FNV-1a
+  for (size_t i = 0; i < n; i++)
+  {
+    h ^= p[i];
+    h *= 1099511628211ULL;
+  }
+  return h ? h : 1;
+}
+
+static void live_emit(struct persistent_state *ps, ui_state *ui, fz_display_list *dl)
+{
+  if (ui->live_width <= 0 || !dl)
+    return;
+  fz_context *ctx = ps->ctx;
+  fz_rect b = fz_bound_display_list(ctx, dl);
+  float bw = b.x1 - b.x0, bh = b.y1 - b.y0;
+  if (bw <= 0 || bh <= 0)
+    return;
+  float scale = ui->live_width / bw;
+  int w = ui->live_width, h = (int)ceilf(bh * scale);
+  fz_pixmap *pm = NULL;
+  fz_device *dev = NULL;
+  fz_buffer *png = NULL;
+  fz_var(pm);
+  fz_var(dev);
+  fz_var(png);
+  fz_try(ctx)
+  {
+    pm = fz_new_pixmap(ctx, fz_device_rgb(ctx), w, h, NULL, 0);
+    fz_clear_pixmap_with_value(ctx, pm, 255);
+    fz_matrix ctm = fz_scale(scale, scale);
+    ctm = fz_pre_translate(ctm, -b.x0, -b.y0);
+    dev = fz_new_draw_device(ctx, ctm, pm);
+    fz_run_display_list(ctx, dl, dev, fz_identity, b, NULL);
+    fz_close_device(ctx, dev);
+
+    uint64_t hash = live_hash_bytes(fz_pixmap_samples(ctx, pm),
+                                    (size_t)fz_pixmap_stride(ctx, pm) * h);
+    if (ui->live_page != ui->page || ui->live_w != w || ui->live_h != h ||
+        ui->live_hash != hash)
+    {
+      png = fz_new_buffer_from_pixmap_as_png(ctx, pm, fz_default_color_params);
+      ui->live_page = ui->page;
+      ui->live_w = w;
+      ui->live_h = h;
+      ui->live_hash = hash;
+      ui->live_scale = scale;
+      ui->live_x0 = b.x0;
+      ui->live_y0 = b.y0;
+      editor_live_page(ui->page, send(page_count, ui->eng), w, h, png);
+    }
+  }
+  fz_always(ctx)
+  {
+    fz_drop_buffer(ctx, png);
+    fz_drop_device(ctx, dev);
+    fz_drop_pixmap(ctx, pm);
+  }
+  fz_catch(ctx)
+  {
+    fprintf(stderr, "[live] no se pudo dibujar la página: %s\n", fz_caught_message(ctx));
+  }
+}
